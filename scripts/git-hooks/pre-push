#!/bin/sh
# 푸시 전 빌드 + 테스트 검증.
# ./gradlew build 안에 spotlessCheck, test 가 모두 포함되어 있다.
# 실패 시 푸시 차단.

set -e

# 삭제 푸시(remote 브랜치 삭제)는 스킵
remote="$1"
url="$2"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

push_has_changes=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" != "$zero" ]; then
        push_has_changes=1
        break
    fi
done

if [ "$push_has_changes" -eq 0 ]; then
    exit 0
fi

echo "[pre-push] ./gradlew build 실행 중 (spotlessCheck + test 포함)..."

if ! ./gradlew --quiet build; then
    echo ""
    echo "❌ 빌드/테스트 실패 — 푸시가 차단됐습니다."
    echo "   실패 원인을 고친 뒤 다시 푸시하세요."
    echo ""
    echo "   포맷 문제라면: ./gradlew spotlessApply"
    echo "   테스트만 다시 돌리려면: ./gradlew test"
    echo ""
    exit 1
fi

echo "[pre-push] OK"
exit 0
