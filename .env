# 과제 평가 편의를 위해 저장소에 함께 커밋된 기본 환경값입니다.

# 앱 포트
APP_PORT=8080

# PostgreSQL
POSTGRES_DB=creator_settlement
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Spring / JPA
SPRING_JPA_DDL_AUTO=update

# JVM 옵션
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Duser.timezone=Asia/Seoul
